# Copy to .env and change the secrets before sharing the app with anyone.
ENVIRONMENT=production
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
ADMIN_EMAIL=admin@data360.local
ADMIN_PASSWORD=change-me-now

POSTGRES_USER=data360
POSTGRES_PASSWORD=data360
POSTGRES_DB=data360

# Optional
WEB_PORT=8080
STALE_DAYS=90
# Reference date for timeliness (YYYY-MM-DD). Blank = today.
REFERENCE_DATE=
MAX_UPLOAD_MB=50

# Folder scan (Upload files -> Scan a folder). The folder on THIS computer that Data360 may read.
# It is mounted read-only; Data360 cannot change or delete anything in it, and sees nothing outside it.
# Build a planted test folder with:  python seed/make_scan_test.py C:/Users/you/Data360-test  (WSL: python3, /mnt/c/Users/you/...)
# Use forward slashes, and a folder you own (not the top of C:). From WSL use /mnt/c/... Blank = ./scan-test inside the repo.
SCAN_HOST_DIR=

# Assistant ("Ask Data 360"). Nothing is sent anywhere until an admin switches it on for a client.
# Put ONE key here; the assistant uses the first one that is set (OpenRouter, then OpenAI, then Anthropic).
# OpenRouter: create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Model. Blank = openrouter/free (OpenRouter picks a free model that can look things up).
# To use a better or paid model later, put its OpenRouter model ID here, e.g. a model copied from openrouter.ai/models.
AI_MODEL=
# Replace client names, identifiers and personal details with tokens before anything reaches the model.
AI_REDACT=true
# Cloud alternatives for a bank deployment (set AI_PROVIDER=bedrock or vertex, and AI_MODEL):
# AWS_REGION=ap-southeast-1          (Bedrock; AWS credentials from the usual AWS_* variables or an instance role)
# VERTEX_PROJECT=
# VERTEX_REGION=asia-southeast1      (Vertex; Google application default credentials)
