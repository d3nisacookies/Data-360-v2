# Copy to .env and change the secrets before sharing the app with anyone.
ENVIRONMENT=production
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
ADMIN_EMAIL=admin@data360.local
ADMIN_PASSWORD=change-me-now

POSTGRES_USER=data360
POSTGRES_PASSWORD=data360
POSTGRES_DB=data360

# Optional
WEB_PORT=8080
STALE_DAYS=90
# Reference date for timeliness (YYYY-MM-DD). Blank = today.
REFERENCE_DATE=
MAX_UPLOAD_MB=50

# Assistant ("Ask Data 360"). Nothing is sent anywhere until an admin switches it on for a client.
# ollama = free local model (start it with: docker compose --profile ai up -d)
# anthropic | bedrock | vertex = cloud providers, configured here on the server only
AI_PROVIDER=ollama
# Blank = qwen2.5:7b for Ollama (try qwen2.5:3b on a laptop with little memory), claude-sonnet-5-5 for Anthropic.
# For Bedrock or Vertex, use the model ID enabled in your cloud account.
AI_MODEL=
# Replace client names, identifiers and personal details with tokens before anything reaches the model.
AI_REDACT=true
# ANTHROPIC_API_KEY=
# AWS_REGION=ap-southeast-1          (Bedrock; AWS credentials from the usual AWS_* variables or an instance role)
# VERTEX_PROJECT=
# VERTEX_REGION=asia-southeast1      (Vertex; Google application default credentials)
